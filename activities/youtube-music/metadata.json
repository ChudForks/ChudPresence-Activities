{
  "id": "youtube-music",
  "name": "YouTube Music",
  "description": "Show the song, artist, and playback progress from YouTube Music.",
  "version": "1.0.7",
  "apiVersion": 1,
  "author": {
    "name": "ChudPresence"
  },
  "category": "music",
  "defaultMediaKind": "song",
  "aliases": ["YT Music", "YTM"],
  "tags": ["music", "streaming"],
  "serviceUrl": "https://music.youtube.com/",
  "matches": [
    "https://music.youtube.com/*"
  ],
  "entry": "activity.js",
  "icon": "icon.png",
  "presence": {
    "kind": "music"
  },
  "settingsUi": {
    "statusLabels": {
      "app": "YouTube Music",
      "artist": "Artist",
      "track": "Song title"
    }
  },
  "settings": [
    {
      "id": "displayMode",
      "type": "select",
      "label": "Secondary line",
      "default": "artist",
      "options": [
        { "label": "Artist", "value": "artist" },
        { "label": "Album", "value": "album" }
      ]
    },
    {
      "id": "showAlbum",
      "type": "boolean",
      "label": "Use album when selected",
      "default": true
    },
    {
      "id": "showArtwork",
      "type": "boolean",
      "label": "Show artwork",
      "default": true
    }
  ]
}
