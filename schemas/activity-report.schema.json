{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChudForks/ChudPresence-Activities/blob/main/schemas/activity-report.schema.json",
  "title": "ChudPresence Activity API v1 Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["title"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
    "artist": { "type": "string", "maxLength": 256 },
    "album": { "type": "string", "maxLength": 256 },
    "details": { "type": "string", "maxLength": 256 },
    "state": { "type": "string", "maxLength": 256 },
    "artwork": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://" },
    "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://" },
    "playing": { "type": "boolean" },
    "position": { "type": "number", "minimum": 0, "maximum": 31536000 },
    "duration": { "type": "number", "minimum": 0, "maximum": 31536000 },
    "kind": { "enum": ["video", "movie", "episode", "song", "stream", "game", "generic"] },
    "buttons": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "\\S" },
          "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://" }
        }
      }
    }
  }
}
