{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChudForks/ChudPresence-Activities/blob/main/schemas/catalog.schema.json",
  "title": "ChudPresence Activity Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "activities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "version", "apiVersion", "matches", "entry", "metadata", "sha256", "metadataSha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "version": { "type": "string" },
          "apiVersion": { "enum": [1] },
          "category": { "type": "string" },
          "settingsUi": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "statusLabels": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "app": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
                  "artist": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
                  "track": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" }
                }
              }
            }
          },
          "matches": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string" } },
          "entry": { "type": "string" },
          "metadata": { "type": "string" },
          "icon": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "metadataSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "iconSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "allOf": [
          {
            "if": { "required": ["icon"] },
            "then": { "required": ["iconSha256"] }
          }
        ]
      }
    }
  }
}
