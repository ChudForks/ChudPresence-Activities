{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChudForks/ChudPresence-Activities/blob/main/schemas/activity.schema.json",
  "title": "ChudPresence Activity Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "version", "apiVersion", "matches", "entry"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$" },
    "apiVersion": { "enum": [1] },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "matches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 256, "pattern": "^https://[^/]+/.+$" }
    },
    "entry": { "const": "activity.js" },
    "icon": { "const": "icon.png" },
    "executionWorld": { "const": "USER_SCRIPT" },
    "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "kind": { "enum": ["music", "video", "streaming", "generic"] } }
    }
  }
}
